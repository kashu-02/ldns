+		unsigned int byte;
+		if (sscanf(d + i * 2, "%2x", &byte) != 1) {
+			LDNS_FREE(pk);
+			LDNS_FREE(sk);
+			LDNS_FREE(oqs);
+			return NULL;
+		}
+		pk[i] = (unsigned char)byte;
+	}
